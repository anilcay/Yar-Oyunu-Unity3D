    Definition: {fileID: 0}
    ThemeColor: {r: 0.3, g: 0.55, b: 0.9, a: 1}
    DeveloperOnly: 0
  - TrackId: canyon
    DisplayName: "K\u0131z\u0131l Kanyon"
    Description: "\xC7\xF6l kanyonu: k\u0131z\u0131l kaya kuleleri, dar ge\xE7it,
      do\u011Fal kaya kemeri. G\xFCn bat\u0131m\u0131."
