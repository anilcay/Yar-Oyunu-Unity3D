  - TrackId: alpine
    DisplayName: "\xC7am Zirvesi"
    Description: "Alp da\u011F\u0131: \xE7am orman\u0131, \u015Felale ve dere, u\xE7urum
      kenar\u0131nda panoramik viraj, kaya t\xFCneli."
